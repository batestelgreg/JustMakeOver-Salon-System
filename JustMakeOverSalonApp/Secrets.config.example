<?xml version="1.0" encoding="utf-8" ?>
<!-- Copy this file to Secrets.config (gitignored) and enter your real Gmail address
     and 16-character Google App Password. Never commit Secrets.config to Git. -->
<appSettings>
    <add key="SmtpSenderEmail" value="your-salon-email@gmail.com" />
    <add key="SmtpAppPassword" value="xxxx-xxxx-xxxx-xxxx" />
</appSettings>
