<?xml version="1.0" encoding="utf-8" ?>
<configuration>
    <startup>
        <supportedRuntime version="v4.0" sku=".NETFramework,Version=v4.8" />
    </startup>
    <connectionStrings>
        <!-- Kani nga connection string kay para sa local SQL Server Express instance. -->
        <add name="SalonDb"
             connectionString="Data Source=.\SQLEXPRESS;Initial Catalog=JustMakeOverSalonDB;Integrated Security=True;TrustServerCertificate=True"
             providerName="System.Data.SqlClient" />
    </connectionStrings>
    <!-- Non-secret SMTP defaults; sensitive credentials (SmtpSenderEmail, SmtpAppPassword)
         live in Secrets.config which is gitignored so credentials are never pushed. -->
    <appSettings file="Secrets.config">
        <add key="SmtpHost" value="smtp.gmail.com" />
        <add key="SmtpPort" value="587" />
        <add key="SmtpUseStartTls" value="true" />
        <add key="SmtpSenderName" value="Just MakeOver Beauty Salon &amp; Spa" />
        <add key="SmtpTimeoutMs" value="20000" />
        <add key="PoPaymentTerms" value="Net 30 Days upon delivery and inspection" />
    </appSettings>
</configuration>
