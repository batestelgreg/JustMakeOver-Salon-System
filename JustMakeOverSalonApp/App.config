<?xml version="1.0" encoding="utf-8" ?>
<configuration>
    <startup>
        <supportedRuntime version="v4.0" sku=".NETFramework,Version=v4.8" />
    </startup>
    <connectionStrings>
        <!-- Kani nga connection string kay para sa local SQL Server Express instance. -->
        <add name="SalonDb"
             connectionString="Data Source=.\SQLEXPRESS;Initial Catalog=JustMakeOverSalonDB;Integrated Security=True;TrustServerCertificate=True"
             providerName="System.Data.SqlClient" />
    </connectionStrings>
</configuration>
